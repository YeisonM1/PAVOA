# Copia este archivo como .env.local y completa los valores

# Frontend publico
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SHOPIFY_DOMAIN=
VITE_SHOPIFY_TOKEN=
VITE_APP_URL=
VITE_WHATSAPP_NUMBER=

# Backend Shopify
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Opcional/legado. Si usas Dev Dashboard, el backend puede funcionar con CLIENT_ID + CLIENT_SECRET.
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# Backend Mercado Pago
MP_ACCESS_TOKEN=
MP_EXPECTED_USER_ID=
# Opcional/legado como alias de MP_EXPECTED_USER_ID
MP_SELLER_USER_ID=
MP_WEBHOOK_SECRET=

# Backend correo
RESEND_API_KEY=
MAIL_PROVIDER=resend
MAIL_FROM_NAME=PAVOA
MAIL_FROM_EMAIL=onboarding@resend.dev
MAIL_REPLY_TO_EMAIL=pavoacol@gmail.com
MAILTRAP_SANDBOX_API_TOKEN=
MAILTRAP_SANDBOX_INBOX_ID=

# Backend auth y permisos
JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
